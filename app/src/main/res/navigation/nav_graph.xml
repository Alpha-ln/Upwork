<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeItem">

    <fragment
        android:id="@+id/homeItem"
        android:name="com.example.upwork.view.HostFragment"
        android:label="Home"
        tools:layout="@layout/fragment_host" >
        <action
            android:id="@+id/action_homeItem_to_instructorPlaylist"
            app:destination="@id/instructorPlaylist" />
    </fragment>

    <fragment
        android:id="@+id/historyItem"
        android:name="com.example.upwork.view.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" >
        <action
            android:id="@+id/action_historyItem_to_videoDetailsFragment"
            app:destination="@id/videoDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/videoDetailsFragment"
        android:name="com.example.upwork.view.VideoDetailsFragment"
        android:label="Video Details"
        tools:layout="@layout/fragment_video_details" />
    <fragment
        android:id="@+id/instructorPlaylist"
        android:name="com.example.upwork.view.InstructorPlaylist"
        android:label="fragment_instructor_playlist"
        tools:layout="@layout/fragment_instructor_playlist" >
        <action
            android:id="@+id/action_instructorPlaylist_to_videoDetailsFragment"
            app:destination="@id/videoDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/codeGeneratingItem"
        android:name="com.example.upwork.view.CodeGeneratingFragment"
        android:label="Generate Codes"
        tools:layout="@layout/fragment_code_generating" />

    <fragment
        android:id="@+id/adminPanelItem"
        android:name="com.example.upwork.view.AdminPanelFragment"
        android:label="Admin Panel"
        tools:layout="@layout/fragment_admin_panel" />

</navigation>